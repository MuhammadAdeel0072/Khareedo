# Khareedo — environment configuration template
# Copy to .env and fill in real values. NEVER commit real secrets.

# SQLite (development and isolated tests); the app runtime uses
# SUPABASE_POSTGRES_URL instead.
DATABASE_URL="file:../db/custom.db"

# NextAuth (REQUIRED) — generate: openssl rand -base64 32
NEXTAUTH_SECRET=""
# Optional. When unset (recommended for localhost dev and preview/proxy
# deployments), NextAuth derives the origin from request headers, so sign-in
# works on any host without code changes. Set it ONLY for a fixed production
# domain. Remember to register each public origin's callback in Google Cloud:
#   {origin}/api/auth/callback/google
#NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional — provider auto-enables when both keys exist)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# SMTP email verification (required for email/password registration)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Supabase Postgres (application runtime — see docs/DATABASE-MIGRATION.md)
# Use a session-mode pooler URL (port 5432) for persistent IPv4-only runtimes.
SUPABASE_POSTGRES_URL=""
# Optionally download the database CA certificate from Supabase Database
# Settings and set this path to trust that root explicitly at runtime.
SUPABASE_DB_CA_CERT=""
# NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""  # SERVER ONLY; never expose to browser code

# ─── Safepay payments (sandbox-only phase — see docs/SAFEPAY-SERVER-INTEGRATION.md) ───
# Never prefix these with NEXT_PUBLIC. All origins/URLs derive from these values; no
# localhost or production domain is hardcoded in application code.
SAFEPAY_ENVIRONMENT="sandbox"
SAFEPAY_ENTRY_MODE="flex"
SAFEPAY_MERCHANT_API_KEY=""
SAFEPAY_SECRET_KEY=""
SAFEPAY_MERCHANT_ACCOUNT_REF=""
# Trusted callback origin. Optional: when unset (recommended for localhost dev
# and preview/proxy deployments), the checkout session route derives the public
# origin per-request from proxy headers. Set it ONLY for a fixed production
# domain (HTTPS there, or http://localhost:PORT in sandbox).
# The webhook endpoint URL is: {SAFEPAY_SITE_ORIGIN}/api/webhooks/safepay
#SAFEPAY_SITE_ORIGIN="http://localhost:3000"
# Independent local return-state signing key, >= 32 printable characters.
SAFEPAY_RETURN_STATE_SECRET=""
#SAFEPAY_TIMEOUT_MS="10000"
# Dashboard > Developers > Endpoints shared webhook secret (HMAC-SHA512 verification).
# Webhook activation is independent of hosted-session activation.
SAFEPAY_WEBHOOK_SECRET=""
# 32-byte base64 key encrypting stored webhook payloads (openssl rand -base64 32).
PAYMENT_PAYLOAD_KEY=""
#PAYMENT_PAYLOAD_KEY_ID="primary"
# Optional: when set, POST /api/admin/payments/maintenance also requires this header
# value (x-khd-maintenance-token) on top of the admin session.
#SAFEPAY_MAINTENANCE_TOKEN=""
