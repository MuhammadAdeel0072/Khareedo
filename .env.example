# Khareedo — environment configuration template
# Copy to .env and fill in real values. NEVER commit real secrets.

# SQLite (development and isolated tests); the app runtime uses
# SUPABASE_POSTGRES_URL instead.
DATABASE_URL="file:../db/custom.db"

# NextAuth (REQUIRED) — generate: openssl rand -base64 32
# The secret must be at least 32 characters. Shorter secrets still work but
# the app logs a loud SECURITY warning at startup (Phase 2, area F); the CI
# build uses a shorter dummy and must be lengthened there too (see the
# Phase 2 security-finalization PR body).
NEXTAUTH_SECRET=""
# REQUIRED in production: set it to the production https origin
# (e.g. https://shop.example.pk). Without it, NextAuth derives the origin
# from request headers and the session cookie is served WITHOUT Secure, and
# the app logs a loud warning at startup. A non-localhost http:// URL in
# production fails fast at startup. For localhost dev and plain-HTTP
# preview deployments, leave it unset or set it to http://localhost:3000 —
# Secure is then off (correctly) and sign-in keeps working. Remember to
# register each public origin's callback in Google Cloud:
#   {origin}/api/auth/callback/google
#NEXTAUTH_URL="http://localhost:3000"

# Trusted proxy (Phase 2, area G) — comma-separated list of proxy IPs whose
# X-Forwarded-For / X-Real-IP / X-Forwarded-Host / X-Forwarded-Proto the app
# may trust. REQUIRED in production when the app sits behind a reverse
# proxy (the proxy MUST overwrite those headers, not append to them — the
# Caddyfile does). When unset, forwarded headers are IGNORED and every
# client is reported as "unknown": per-IP rate limits collapse into one
# shared bucket and request origins fall back to the Host header. In
# production an unset value logs a SECURITY warning once per process (log
# only — the app still boots). Accepted entries: single IPv4 (127.0.0.1)
# or IPv6 (::1) addresses, or CIDR ranges (10.0.0.0/24 for a proxy subnet;
# 10.0.0.1/32 is one host). Whitespace and duplicates are tolerated.
# Invalid entries (hostnames, malformed addresses, out-of-range prefixes,
# 0.0.0.0/0) are logged and IGNORED, never trusted. Never put a client IP,
# a public range, or 0.0.0.0/0 here. No proxy IP has been supplied yet
# (Q-01) — set this to the production proxy's real IP(s) once the hosting
# environment is chosen; exact steps in docs/DEPLOYMENT.md.
#TRUSTED_PROXY_IPS=""

# Google OAuth (optional — provider auto-enables when both keys exist)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# SMTP email verification (required for email/password registration)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# ─── Database seeding (see docs/SEEDING.md) ───
# The seed is opt-in and local-SQLite-only: SEED_ALLOW=1, never in production,
# DATABASE_URL must be a local file: URL. Accounts are created only when their
# password is supplied here (or in the shell); without it the account is skipped.
# Passwords must be 12-72 characters and never a published demo password.
#SEED_ALLOW="1"
#SEED_ADMIN_PASSWORD=""
#SEED_CUSTOMER_PASSWORD=""

# Supabase Postgres (application runtime — see docs/DATABASE-MIGRATION.md)
# Use a session-mode pooler URL (port 5432) for persistent IPv4-only runtimes.
SUPABASE_POSTGRES_URL=""
# REQUIRED when connecting to a Supabase host (pooler or direct). Supabase
# Postgres presents a certificate signed by Supabase's private CA (Supabase
# Root 2021 CA), which is not in the runtime's trusted roots, so verify-full
# TLS fails without it. Download the database CA certificate from Supabase
# Database Settings → SSL Configuration and set this path to the file.
# The app fails fast with a clear error if this is unset for a Supabase host.
SUPABASE_DB_CA_CERT=""
# NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""  # SERVER ONLY; never expose to browser code

# ─── Safepay payments (sandbox-only phase — see docs/SAFEPAY-SERVER-INTEGRATION.md) ───
# Never prefix these with NEXT_PUBLIC. All origins/URLs derive from these values; no
# localhost or production domain is hardcoded in application code.
SAFEPAY_ENVIRONMENT="sandbox"
SAFEPAY_ENTRY_MODE="flex"
SAFEPAY_MERCHANT_API_KEY=""
SAFEPAY_SECRET_KEY=""
SAFEPAY_MERCHANT_ACCOUNT_REF=""
# Trusted callback origin. Optional: when unset (recommended for localhost dev
# and preview/proxy deployments), the checkout session route derives the public
# origin per-request from proxy headers. Set it ONLY for a fixed production
# domain (HTTPS there, or http://localhost:PORT in sandbox).
# The webhook endpoint URL is: {SAFEPAY_SITE_ORIGIN}/api/webhooks/safepay
#SAFEPAY_SITE_ORIGIN="http://localhost:3000"
# Independent local return-state signing key, >= 32 printable characters.
SAFEPAY_RETURN_STATE_SECRET=""
#SAFEPAY_TIMEOUT_MS="10000"
# Dashboard > Developers > Endpoints shared webhook secret (HMAC-SHA512 verification).
# Webhook activation is independent of hosted-session activation.
SAFEPAY_WEBHOOK_SECRET=""
# 32-byte base64 key encrypting stored webhook payloads (openssl rand -base64 32).
PAYMENT_PAYLOAD_KEY=""
#PAYMENT_PAYLOAD_KEY_ID="primary"
# 32-byte base64 key encrypting stored admin TOTP MFA secrets (openssl rand -base64 32).
# Required for admin MFA enrollment/verification (PR-10). Without it, MFA setup
# and verification fail closed (503). Rotating it makes existing MFA secrets
# undecryptable — enrolled admins must re-enroll. Keep it out of git.
ADMIN_MFA_ENCRYPTION_KEY=""
# Optional: when set, POST /api/admin/payments/maintenance also requires this header
# value (x-khd-maintenance-token) on top of the admin session.
#SAFEPAY_MAINTENANCE_TOKEN=""
# In-process maintenance worker (instrumentation.ts): runs reservation expiry, webhook
# inbox processing and provider reconciliation sweeps every ~60s. Set to "off" on
# serverless deploys and schedule POST /api/admin/payments/maintenance externally
# (e.g. Vercel Cron) with an admin session or the maintenance token instead.
#PAYMENT_MAINTENANCE_WORKER="off"

# ─── Error monitoring and payment alerts (see docs/ERROR-MONITORING.md) ───
# Centralized capture is on by default and always logs structured JSON lines;
# email alerts need a recipient AND the SMTP settings above.
#ERROR_MONITORING_ENABLED="true"
#ERROR_MONITORING_ALERT_EMAIL="ops@example.com"
#ERROR_MONITORING_ALERT_THROTTLE_MS="900000"

# ─── Diagnostics ───
# Set to "debug" for detailed Prisma and performance diagnostics
# (see README.md). Default is info-level logging.
#LOG_LEVEL="debug"
