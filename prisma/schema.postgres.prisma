// Khareedo â€” Smart E-Commerce Platform
// PostgreSQL schema for Supabase; the application continues to use Prisma and
// NextAuth, with server-side database access only.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/postgres-client"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ Users & Accounts â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String? // null â†’ OAuth-only account (Google). Credentials managed by auth layer, never in app tables
  name          String?
  phone         String?
  image         String?
  role          String    @default("CUSTOMER") // CUSTOMER | ADMIN (see user_roles in Supabase SQL)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  addresses     Address[]
  orders        Order[]
  cart          Cart?
  wishlistItems WishlistItem[]
  oauthAccounts OAuthAccount[]
  verificationTokens VerificationToken[]

  @@index([role, createdAt])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model VerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String   @default("Home")
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  province   String
  postalCode String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ Catalogue â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([parentId])
  @@index([isActive])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @default("")
  brand       String?
  sku         String?  @unique
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])

  // Money stored as INTEGER PKR (whole rupees) â€” no floating point errors
  price        Int
  comparePrice Int? // strike-through "was" price; discount derived

  status     String  @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED (FR-39, FR-13)
  isFeatured Boolean @default(false)   // FR-12, FR-42

  // Display-only ratings (decision D-08)
  rating      Float @default(0)
  reviewCount Int   @default(0)

  tags      String? // comma-separated keywords for search (FR-09)
  deletedAt DateTime? // soft archive

  images        ProductImage[]
  inventory     Inventory?
  cartItems     CartItem[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([isFeatured])
  @@index([price])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int     @default(0)

  @@index([productId])
}

model Inventory {
  id                String   @id @default(cuid())
  productId         String   @unique
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity          Int      @default(0) // never negative â€” guarded in checkout transaction
  lowStockThreshold Int      @default(5)
  updatedAt         DateTime @updatedAt

  @@index([quantity])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ Cart & Wishlist â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Cart {
  id         String   @id @default(cuid())
  userId     String?  @unique
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionKey String?  @unique // guest cart (BR-01, FR-17)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items CartItem[]
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  giftWrap  Boolean @default(false)

  @@unique([cartId, productId])
  @@index([cartId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ Orders â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Order {
  id        String   @id @default(cuid())
  reference String   @unique // KH + yymmdd + random (FR-24)
  // Idempotency (FR-27, BR-08): one order per checkout attempt
  idempotencyKey String @unique

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  isGuest Boolean @default(false)

  // Customer contact snapshot (BR-09)
  customerName  String
  customerEmail String
  customerPhone String

  // Delivery address snapshot (BR-09) â€” independent of addresses table
  shipFullName  String
  shipPhone     String
  shipLine1     String
  shipLine2     String?
  shipCity      String
  shipProvince  String
  shipPostalCode String?

  status        String @default("PENDING") // PENDING | CONFIRMED | PROCESSING | SHIPPED | DELIVERED | CANCELLED
  paymentMethod String @default("COD")     // COD | BANK_TRANSFER | ONLINE
  paymentStatus String @default("PENDING") // PENDING | PAID | FAILED | REFUNDED

  // Money snapshots (BR-04/06/09/15) â€” INTEGER PKR
  subtotal       Int
  discountTotal  Int     @default(0)
  deliveryFee    Int     @default(0)
  deliveryMethod String  @default("STANDARD") // STANDARD | EXPRESS
  giftWrapCharge Int     @default(0)
  taxTotal       Int     @default(0) // reserved, zero until tax policy confirmed
  total          Int

  giftWrapSelected Boolean @default(false)
  giftWrapMessage  String?
  couponCode       String?
  couponTitle      String?
  notes            String?

  items    OrderItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([status, createdAt])
  @@index([createdAt])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  // Line snapshot (BR-09, NFR-31): survives later product edits/archival
  productName String
  productSlug String
  imageUrl    String?
  unitPrice   Int
  quantity    Int
  lineTotal   Int
  giftWrap    Boolean @default(false)

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider  String   // COD | BANK_TRANSFER | <gateway name when enabled>
  amount    Int
  status    String   @default("PENDING") // PENDING | PAID | FAILED | REFUNDED
  reference String?  // provider transaction reference (BR-10: only set from verified response)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ Marketing â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Promotion {
  id             String    @id @default(cuid())
  title          String
  description    String?
  type           String    @default("PERCENT") // PERCENT | FIXED
  value          Int // percent (1-100) or fixed PKR amount
  minOrderAmount Int?
  startsAt       DateTime?
  endsAt         DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  description    String?
  type           String    @default("PERCENT") // PERCENT | FIXED
  value          Int
  minOrderAmount Int       @default(0)
  maxUses        Int? // null = unlimited
  usedCount      Int       @default(0)
  startsAt       DateTime?
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isActive])
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String
  linkUrl   String?
  placement String   @default("HERO") // HERO | SIDE | STRIP
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placement, isActive])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ Settings â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model StoreSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
