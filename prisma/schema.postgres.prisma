// Khareedo â€” Smart E-Commerce Platform
// PostgreSQL schema for Supabase; the application continues to use Prisma and
// NextAuth, with server-side database access only.

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/postgres-client"
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
  previewFeatures = ["relationJoins"]
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ Users & Accounts â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String? // null â†’ OAuth-only account (Google). Credentials managed by auth layer, never in app tables
  name          String?
  phone         String?
  image         String?
  role          String    @default("CUSTOMER") // CUSTOMER | ADMIN (see user_roles in Supabase SQL)
  emailVerified DateTime?
  // Set whenever the password is changed (reset or admin action). The auth
  // guard invalidates JWT sessions issued at or before this timestamp, since
  // NextAuth v4 JWTs are not revocable (PR-09).
  passwordChangedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  addresses     Address[]
  orders        Order[]
  cart          Cart?
  wishlistItems WishlistItem[]
  reviews       Review[]
  oauthAccounts OAuthAccount[]
  verificationTokens VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  adminMfa      AdminMfa?
  adminAuditLogs AdminAuditLog[]

  @@index([role, createdAt])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model VerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Password reset tokens (PR-09). Kept separate from VerificationToken so a
// verification token can never be redeemed as a reset token (and vice versa).
// Same pattern: only the SHA-256 hash is stored; the raw token is emailed
// once and never persisted. Single-use (consumedAt) and expiring.
model PasswordResetToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email      String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Administrator TOTP MFA (PR-10). One row per admin, created at enrollment.
// The TOTP secret is stored AES-256-GCM encrypted (see
// src/services/admin-mfa.service.ts); only the ciphertext is persisted, never
// the plaintext secret. enabledAt is null while enrollment is pending (the
// admin has a secret + QR code but has not yet verified a first code).
// lastVerifiedAt records the last successful TOTP/recovery verification;
// the auth guard requires it to be after the session's issued-at time, so
// each new session must verify MFA again (same pattern as PR-09's
// passwordChangedAt). lastUsedStep is the TOTP time step of the last accepted
// code, for replay protection: a code from the same or an earlier step is
// rejected. pendingSecretEncrypted holds a replacement secret while a
// replacement enrollment is in progress (PR-10 security fix): the ACTIVE
// secret stays in secretEncrypted until the replacement is verified, so a
// failed or abandoned replacement never disables MFA or invalidates the
// active secret or recovery codes.
model AdminMfa {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretEncrypted Bytes
  pendingSecretEncrypted Bytes?
  enabledAt       DateTime?
  lastVerifiedAt  DateTime?
  // Session the admin last verified MFA in (Phase 2, area B — M-4). The
  // guard requires this to equal the current session's `sid` claim, so a
  // verification in one session cannot authorize a different (possibly
  // stolen) session. NULL means never verified in a bound session.
  lastVerifiedSessionId String?
  lastUsedStep    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  recoveryCodes   AdminMfaRecoveryCode[]
}

// One-time recovery codes for admin MFA (PR-10). Only the SHA-256 hash is
// stored; the raw code is shown to the admin once at generation and never
// persisted or logged. A code is single-use: usedAt is set atomically on
// redemption (guarded by usedAt null), and regeneration deletes all previous
// codes.
model AdminMfaRecoveryCode {
  id         String    @id @default(cuid())
  mfaId      String
  mfa        AdminMfa  @relation(fields: [mfaId], references: [id], onDelete: Cascade)
  codeHash   String    @unique
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([mfaId])
}

// Append-only administrator audit log (PR-12). One row per security-
// relevant admin action (MFA lifecycle, product/category/inventory/order/
// refund/payment/settings changes, exports). The application never updates
// or deletes these rows: there is no update/delete API for them, and the
// service only exposes record + list. adminUserId is nullable with
// onDelete: SetNull so deleting an admin account does not erase history.
// metadata is minimal structured context (e.g. before/after values); it
// must NEVER contain passwords, tokens, secrets, TOTP secrets, recovery
// codes, or payment secrets — the service strips sensitive keys.
model AdminAuditLog {
  id          String   @id @default(cuid())
  adminUserId String?
  adminUser   User?    @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  action      String
  targetType  String
  targetId    String?
  requestId   String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([adminUserId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId, createdAt])
}

// Email outbox (PR-09 security-review fix). Password reset emails are sent
// asynchronously by a background worker, never synchronously from the
// forgot-password endpoint — so the endpoint's observable behaviour (status,
// body, timing) is identical whether or not an account exists, and SMTP
// failures can never reveal account existence. The raw reset token is NOT
// stored here: the worker generates it when it delivers the email, so the
// token only ever exists in the worker's memory and in the email itself.
// The row carries only the submitted email address — no userId, no name, no
// account lookup result — so the row itself cannot encode whether an
// account exists. The worker performs the account lookup after the HTTP
// request has returned and silently discards unknown and OAuth-only
// addresses.
model EmailOutbox {
  id            String    @id @default(cuid())
  type          String // "PASSWORD_RESET"
  email         String
  // Optional JSON payload (Phase 3, Chunk 7-final — D14): the data the
  // worker needs to render the email (order reference/total/status for
  // order notifications; callbackUrl for verification mail). Auth rows
  // carry no payload; order rows always do. TEXT, never indexed.
  payload       String?
  status        String    @default("PENDING") // PENDING | FAILED
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, nextAttemptAt])
  @@index([createdAt])
  // Enqueue dedup read (enqueueOutboxEmail: type + email + PENDING status).
  @@index([type, email, status])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String   @default("Home")
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  province   String
  postalCode String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ Catalogue â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([parentId])
  @@index([isActive])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @default("")
  brand       String?
  sku         String?  @unique
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])

  // Money stored as INTEGER PKR (whole rupees) â€” no floating point errors
  price        Int
  comparePrice Int? // strike-through "was" price; discount derived

  status     String  @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED (FR-39, FR-13)
  isFeatured Boolean @default(false)   // FR-12, FR-42

  // Ratings (D-08 display-only, superseded by D13): maintained by
  // in-transaction aggregation over APPROVED reviews — see
  // reviews.service.ts. The seed now writes 0/0.
  rating      Float @default(0)
  reviewCount Int   @default(0)

  tags      String? // comma-separated keywords for search (FR-09)
  deletedAt DateTime? // soft archive

  images        ProductImage[]
  inventory     Inventory[]
  variants      ProductVariant[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]
  reviews       Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([isFeatured])
  @@index([price])
  // Storefront hot-path composites (perf/system-optimization): list/featured/
  // new-arrival/related reads filter on status+deletedAt(+category) and sort by
  // isFeatured+createdAt or rating — see migration 20261121000000_product_index_backfill.
  @@index([status, deletedAt, categoryId])
  @@index([isFeatured, createdAt])
  @@index([rating])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int     @default(0)

  @@index([productId])
}

// Product variants (Phase 3, Chunk 8 — D12): denormalised label-string model.
// One row per sellable option (e.g. "Size: M / Colour: Red") — no normalised
// attribute/option tables in V1. priceOverride is ABSOLUTE (null = inherit
// the product price). Stock is a separate Inventory row per variant; a null
// variantId on cart/order lines means the product itself (no backfill).
// No variant images and no variant filtering in V1.
model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  label         String
  sku           String   @unique
  priceOverride Int?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  inventory  Inventory?
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@index([productId, sortOrder])
}

// Product reviews (Phase 3, Chunk 9 — D13): verified purchasers only
// (a DELIVERED order containing the product), pre-moderation, one review
// per user per product (editable; edits return to PENDING). No per-variant
// reviews in V1 — a review is for the product. Product.rating / reviewCount
// are maintained by in-transaction aggregation over APPROVED reviews only
// (see reviews.service.ts); the seed's invented values are reset to 0/0.
model Review {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating           Int
  text             String?
  status           String   @default("PENDING") // PENDING | APPROVED | REJECTED
  verifiedPurchase Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, productId])
  @@index([productId, status, createdAt])
  @@index([status, createdAt])
}

model Inventory {
  id                String   @id @default(cuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Null = the product-level stock row (variant-less products); set = this
  // variant's own stock row. One row per (productId, variantId): the
  // compound unique below plus the partial unique index in migration
  // 20261120000003 (Postgres and SQLite both treat NULLs as distinct in a
  // plain unique index, so the null-variant row needs its own index).
  variantId         String?  @unique
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity          Int      @default(0) // never negative â€” guarded in checkout transaction
  lowStockThreshold Int      @default(5)
  updatedAt         DateTime @updatedAt

  @@index([quantity])
  @@unique([productId, variantId])
  @@index([variantId])

  // Available quantity keeps its existing meaning. All writers must honor version
  // before reservations can be enabled; schema authoring does not enable them.
  version Int @default(0)
  reservations InventoryReservation[]
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ Cart & Wishlist â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Cart {
  id         String   @id @default(cuid())
  userId     String?  @unique
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionKey String?  @unique // guest cart (BR-01, FR-17)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  // Optimistic-lock claim for the Safepay pending-order creation (Phase 3,
  // chunk 3-final): the cart is claimed version-gated before the snapshot is
  // read, so two concurrent checkouts for the same cart cannot both reserve
  // it. Cart edits do not bump this version; the deleteMany exact-snapshot
  // guard at the end of pending-order creation still catches those.
  version    Int      @default(0)

  items CartItem[]
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int
  giftWrap  Boolean @default(false)

  @@unique([cartId, productId, variantId])
  @@index([cartId])
  @@index([variantId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ Orders â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Order {
  id        String   @id @default(cuid())
  reference String   @unique // KH + yymmdd + random (FR-24)
  // Idempotency (FR-27, BR-08): one order per checkout attempt
  idempotencyKey String @unique

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  isGuest Boolean @default(false)

  // Customer contact snapshot (BR-09)
  customerName  String
  customerEmail String
  customerPhone String

  // Delivery address snapshot (BR-09) â€” independent of addresses table
  shipFullName  String
  shipPhone     String
  shipLine1     String
  shipLine2     String?
  shipCity      String
  shipProvince  String
  shipPostalCode String?

  status        String @default("PENDING") // PENDING | CONFIRMED | PROCESSING | SHIPPED | DELIVERED | CANCELLED
  paymentMethod String @default("COD")     // COD | BANK_TRANSFER | ONLINE
  paymentStatus String @default("PENDING") // PENDING | PAID | FAILED | REFUNDED | CANCELLED

  // Cancellation record (Phase 3, Chunk 2-final — D1/D2): who cancelled, when,
  // and the optional customer/admin reason. Null on orders never cancelled.
  // cancelledBy is "customer:<userId>" or "admin:<adminId>".
  cancelledAt  DateTime?
  cancelledBy  String?
  cancelReason String?

  // Shipment tracking (Phase 3, Chunk 6 — D4): set by an admin when marking
  // an order SHIPPED. Null until then; plain text, no provider integration.
  carrier        String?
  trackingNumber String?

  // Money snapshots (BR-04/06/09/15) â€” INTEGER PKR
  subtotal       Int
  discountTotal  Int     @default(0)
  deliveryFee    Int     @default(0)
  deliveryMethod String  @default("STANDARD") // STANDARD | EXPRESS
  giftWrapCharge Int     @default(0)
  taxTotal       Int     @default(0) // reserved, zero until tax policy confirmed
  total          Int

  giftWrapSelected Boolean @default(false)
  giftWrapMessage  String?
  couponCode       String?
  couponTitle      String?
  // First-order claim (R-1, migration 20261121000001): true when this
  // order redeemed a first-order-only coupon. The partial unique index
  // Order_userId_first_order_coupon_active_idx (raw SQL — Prisma cannot
  // express partial indexes) allows at most one non-cancelled order per
  // user with this flag set, so two concurrent first orders with
  // DIFFERENT first-order-only coupons cannot both commit: the second
  // order.create fails with P2002. Set by the checkout services from
  // Coupon.firstOrderOnly at order creation; never set by clients.
  // Cancelling frees the claim automatically (CANCELLED rows leave the
  // partial index), exactly like the per-user redemption index — no
  // cancel-path change is needed.
  firstOrderCoupon Boolean @default(false)
  // Automatic promotion applied to this order (Chunk 11 — D10). A discount
  // comes from exactly one source: couponCode XOR promotionId, never both.
  promotionId      String?
  promotionTitle   String?
  notes            String?

  items    OrderItem[]
  payments Payment[] @relation("OrderPayments")
  statusHistory OrderStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([status, createdAt])
  @@index([createdAt])
  // Dashboard revenue SUMs filter paymentStatus + createdAt ranges.
  @@index([paymentStatus, createdAt])
  // Order history: WHERE userId = ? ORDER BY createdAt DESC (perf/system-optimization)
  @@index([userId, createdAt])

  // Managed hosted-checkout metadata is NULL on historical/offline orders.
  // Existing PKR snapshots and order/payment statuses retain their meaning.
  paymentFlowVersion Int?
  nextPaymentAttempt Int?
  currency String?
  checkoutOwnerKind String?
  checkoutOwnerHash String?
  checkoutFingerprint String?
  // Keep the cuid() primary key out of relation fields: Prisma otherwise suppresses it.
  // SQL requires this owner to equal id when either pointer is present, including NULL checks.
  paymentOwnerOrderId String?
  activePaymentId String?
  acceptedPaymentId String?
  checkoutCloseReason String?
  paymentReviewStatus String?
  paymentReviewReason String?
  expiryLeaseToken String?
  checkoutAccessExpiresAt DateTime?
  reservationExpiresAt DateTime?
  checkoutClosedAt DateTime?
  expiryLeaseUntil DateTime?
  version Int @default(0)
  activePayment Payment? @relation("OrderActivePayment", fields: [paymentOwnerOrderId, activePaymentId], references: [orderId, id], onDelete: NoAction, onUpdate: NoAction)
  acceptedPayment Payment? @relation("OrderAcceptedPayment", fields: [paymentOwnerOrderId, acceptedPaymentId], references: [orderId, id], onDelete: NoAction, onUpdate: NoAction)
  couponReservation CouponReservation?
  @@unique([paymentOwnerOrderId, activePaymentId])
  @@unique([paymentOwnerOrderId, acceptedPaymentId])
  @@index([paymentFlowVersion, status, reservationExpiresAt])
  @@index([paymentFlowVersion, paymentReviewStatus, updatedAt])
}

// Order status history (Phase 3, Chunk 6 — M-6/D4): one dated row per status
// transition, written in the same transaction as the status change. The admin
// audit log keeps its own ORDER_STATUS_CHANGED entries; this table is the
// customer-facing timeline (actor is internal — never render it to
// customers). Append-only: no update or delete API.
model OrderStatusHistory {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String   // PENDING | CONFIRMED | PROCESSING | SHIPPED | DELIVERED | CANCELLED
  actor     String?  // "admin:<id>" | "customer:<id>" | "system" | "system:expiry"
  note      String?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  // Variant snapshot (BR-09, Chunk 8 — D12): survives later variant edits/
  // deactivation. Null variantId = the product itself (no variant).
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantLabel String?
  variantSku   String?
  // Line snapshot (BR-09, NFR-31): survives later product edits/archival
  productName String
  productSlug String
  imageUrl    String?
  unitPrice   Int
  quantity    Int
  lineTotal   Int
  giftWrap    Boolean @default(false)

  @@index([orderId])
  @@index([productId])
  // Top-selling products group by (productName, productSlug).
  @@index([productName, productSlug])

  inventoryReservation InventoryReservation?
}

model Payment {
  id        String   @id @default(cuid())
  orderId   String
  order Order @relation("OrderPayments", fields: [orderId], references: [id], onDelete: Cascade)
  provider  String   // COD | BANK_TRANSFER | <gateway name when enabled>
  amount    Int
  status    String   @default("PENDING") // PENDING | PAID | FAILED | REFUNDED | CANCELLED
  reference String?  // provider transaction reference (BR-10: only set from verified response)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])

  // One row per managed payment attempt; legacy payment rows retain NULL metadata.
  // Minor-unit values are separate from the existing whole-PKR amount.
  // Tracker/retry identities are locally scoped keys, not provider idempotency promises.
  attemptNumber Int?
  attemptState String?
  providerEnvironment String?
  merchantAccountRef String?
  trackerToken String?
  providerState String?
  currency String?
  reconcileStatus String?
  reconcileLeaseToken String?
  lastErrorCode String?
  providerStateObservedAt DateTime?
  creationStartedAt DateTime?
  trackerBoundAt DateTime?
  paidVerifiedAt DateTime?
  nextReconcileAt DateTime?
  lastReconcileAt DateTime?
  reconcileLeaseUntil DateTime?
  lastErrorAt DateTime?
  expectedAmountMinor BigInt?
  capturedAmountMinor BigInt?
  refundedAmountMinor BigInt?
  retryRequestKey String? @unique
  trackerIdentityKey String? @unique
  reconcileAttempts Int @default(0)
  version Int @default(0)
  activeForOrder Order? @relation("OrderActivePayment")
  acceptedForOrder Order? @relation("OrderAcceptedPayment")
  webhookEvents PaymentWebhookEvent[]
  evidence PaymentEvidence[]
  refunds PaymentRefund[]
  @@unique([orderId, id])
  @@unique([orderId, attemptNumber])
  @@index([provider, reconcileStatus, nextReconcileAt])
  @@index([reconcileStatus, reconcileLeaseUntil])
}

// Safepay persistence only. No provider state vocabulary, event-ID format,
// signature profile, token TTL, or provider idempotency behavior is assumed.
// One immutable allocation identity per order item; state changes must be transactional.
model InventoryReservation {
  id String @id @default(cuid())
  orderItemId String @unique
  inventoryId String
  quantity Int
  state String @default("HELD")
  heldAt DateTime @default(now())
  consumedAt DateTime?
  releasedAt DateTime?
  restoredAt DateTime?
  releaseReason String?
  version Int @default(0)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@index([inventoryId, state])
}

// One coupon hold per order. Committing moves held capacity into existing usedCount.
model CouponReservation {
  id String @id @default(cuid())
  orderId String @unique
  couponId String
  state String @default("HELD")
  heldAt DateTime @default(now())
  committedAt DateTime?
  releasedAt DateTime?
  releaseReason String?
  version Int @default(0)
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@index([couponId, state])
}

// Durable verified inbox. Nullable provider envelope fields permit quarantine without
// inventing an event-ID/version contract. Hashes are local SHA-256 body digests,
// not a definition of Safepay's signed representation. Payloads must be encrypted;
// normalizedPayloadJson is allowlisted data only. Keys/secrets never belong here.
model PaymentWebhookEvent {
  id String @id @default(cuid())
  provider String @default("SAFEPAY")
  providerEnvironment String
  merchantAccountRef String
  providerEventId String?
  eventType String?
  eventVersion String?
  dedupKey String @unique
  trackerToken String?
  trackerIdentityKey String?
  paymentId String?
  businessPayloadSha256 String?
  leaseToken String?
  lastErrorCode String?
  reviewReason String?
  providerOccurredAt DateTime?
  leaseUntil DateTime?
  processedAt DateTime?
  firstReceivedAt DateTime @default(now())
  lastReceivedAt DateTime @default(now())
  deliveryCount Int @default(1)
  processingStatus String @default("RECEIVED")
  processingAttempts Int @default(0)
  nextProcessAt DateTime @default(now())
  reviewRequired Boolean @default(false)
  updatedAt DateTime @updatedAt
  firstPayloadSha256 String
  lastPayloadSha256 String
  payloadFormat String?
  normalizedPayloadJson String?
  payloadKeyId String?
  signatureProfile String?
  signingKeyId String?
  signatureValue String?
  payloadCiphertext Bytes?
  payloadNonce Bytes?
  payloadAuthTag Bytes?
  payloadPurgedAt DateTime?
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  evidence PaymentEvidence[] @relation("WebhookEvidenceSource")
  finalEvidence PaymentEvidence? @relation("WebhookEvidenceFinal")
  @@index([processingStatus, nextProcessAt])
  @@index([processingStatus, leaseUntil])
  @@index([paymentId, firstReceivedAt])
  @@index([trackerIdentityKey])
  @@index([reviewRequired, firstReceivedAt])
}

// Append-only by service policy. detailsJson must be allowlisted, never raw secrets
// or card data. Observed amounts preserve anomalies; validationStatus records trust.
model PaymentEvidence {
  id String @id @default(cuid())
  paymentId String
  source String
  operation String
  validationStatus String
  decision String
  sourceWebhookEventId String?
  providerRequestId String?
  providerContractVersion String?
  observedProviderState String?
  observedCurrency String?
  rawPayloadSha256 String?
  reasonCode String?
  actorUserIdSnapshot String?
  detailsJson String?
  processedWebhookEventId String? @unique
  refundId String?
  providerOccurredAt DateTime?
  observedQuoteMinor BigInt?
  observedCapturedMinor BigInt?
  observedRefundedMinor BigInt?
  paymentVersion Int
  orderVersion Int?
  recordedAt DateTime @default(now())
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  sourceWebhook PaymentWebhookEvent? @relation("WebhookEvidenceSource", fields: [sourceWebhookEventId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  processedWebhook PaymentWebhookEvent? @relation("WebhookEvidenceFinal", fields: [processedWebhookEventId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  refund PaymentRefund? @relation(fields: [refundId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@index([paymentId, recordedAt, id])
  @@index([sourceWebhookEventId])
  @@index([refundId])
}

// Refund ledger: one row per refund operation against a managed payment attempt.
// Money is integer minor units (BigInt); never floating point. operationKey is a
// LOCAL dedup/operation identity only — no provider idempotency behavior is assumed
// (undocumented for the classic refund endpoint). Provider-confirmed facts (state,
// reference, refunded-at) are written exclusively from authenticated evidence.
// The order relationship is payment.orderId; no denormalized order column exists.
model PaymentRefund {
  id                  String   @id @default(cuid())
  paymentId           String
  payment             Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  trackerToken        String
  providerEnvironment String
  merchantAccountRef  String

  amountMinor BigInt
  currency    String
  type        String // FULL | PARTIAL
  status      String @default("REQUESTED") // REQUESTED | SUBMITTING | PENDING | SUCCEEDED | FAILED | REVIEW_REQUIRED
  initiatedBy String @default("ADMIN") // ADMIN | PROVIDER (dashboard/external refund recorded from evidence)

  // Local operation identity, e.g. "ADMIN:<idempotencyKey>", "AUTO:<uuid>", "PROVIDER:<digest>".
  operationKey String @unique

  // Provider observations. Advisory until confirmed by authenticated evidence.
  providerState      String?
  providerReference  String? // reserved: no per-refund provider identifier is documented
  providerRefundedAt DateTime?

  failureCode        String?
  failureMessage     String?
  lastSubmissionCode String? // transport/HTTP code of an uncertain submission outcome
  reviewReason       String?

  requestedByUserId String? // null for provider-initiated (dashboard) refunds

  requestedAt DateTime  @default(now())
  submittedAt DateTime?
  confirmedAt DateTime? // provider confirmation timestamp from verified evidence
  settledAt   DateTime? // local accounting finalization timestamp

  reconcileStatus   String?
  nextReconcileAt   DateTime?
  lastReconcileAt   DateTime?
  reconcileAttempts Int @default(0)

  version Int @default(0)

  evidence PaymentEvidence[]

  @@index([paymentId, status])
  @@index([status, nextReconcileAt])
  @@index([trackerToken])
}


