{
  "name": "nextjs_tailwind_shadcn_ts",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "npm run db:generate:postgres && next build && node -e \"const fs=require('node:fs');const envFile='.next/standalone/.env';if(fs.existsSync(envFile))fs.rmSync(envFile);fs.cpSync('.next/static','.next/standalone/.next/static',{recursive:true,force:true});if(fs.existsSync('public'))fs.cpSync('public','.next/standalone/public',{recursive:true,force:true});\"",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "test:db": "node scripts/run-isolated-sqlite-tests.mjs",
    "test:db:check": "node scripts/run-isolated-sqlite-tests.mjs --check",
    "db:push": "prisma db push --accept-data-loss",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:generate:postgres": "prisma generate --schema prisma/schema.postgres.prisma",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:postgres:deploy": "node --env-file=.env scripts/deploy-postgres-migrations.mjs",
    "db:postgres:transfer:check": "node --env-file=.env scripts/migrate-sqlite-to-postgres.mjs --dry-run",
    "db:postgres:transfer:apply": "node --env-file=.env scripts/migrate-sqlite-to-postgres.mjs --apply"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@supabase/supabase-js": "^2.119.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "exceljs": "^3.4.0",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "next-auth": "^4.24.11",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.13",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "prisma": "6.19.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.4",
    "sharp": "^0.35.5",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "z-ai-web-dev-sdk": "^0.0.18",
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "^1.3.4",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
